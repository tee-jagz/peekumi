{
  "name": "repo-strata",
  "version": "0.2.0",
  "private": true,
  "description": "A mobile repository map, from architecture to source.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "strata": "scripts/start.mjs"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "test": "npm run build:rust && node --test test/*.test.mjs",
    "test:browser": "npm run build:rust && node test/browser.mjs",
    "build:rust": "node scripts/cargo.mjs build --release --locked",
    "test:rust": "node scripts/cargo.mjs test --locked",
    "benchmark:rust": "npm run build:rust && node scripts/benchmark-rust.mjs"
  },
  "dependencies": {
    "typescript": "^5.6.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0"
  }
}
