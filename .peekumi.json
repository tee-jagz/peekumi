{
  "version": 1,
  "groups": {
    "frontend": ["frontend/**"],
    "backend": ["backend/**"],
    "engine": ["backend/engine.rs"],
    "concrete-adapters": [
      "backend/adapters/python.rs",
      "backend/adapters/typescript.rs",
      "backend/adapters/rust.rs",
      "backend/adapters/rust_relationships.rs"
    ],
    "analysis": [
      "backend/engine.rs",
      "backend/relationships.rs",
      "backend/rules.rs",
      "backend/index.rs",
      "backend/adapters/**"
    ],
    "agent-workflow": [
      "backend/workflow.rs",
      "backend/runner.rs",
      "backend/agents.rs",
      "backend/agent_session.rs",
      "backend/task_agent.rs",
      "backend/merge.rs",
      "backend/ask.rs",
      "backend/agent_call.rs",
      "backend/run_store_impl.rs"
    ],
    "frontend-shared": [
      "frontend/icons.js",
      "frontend/text.js",
      "frontend/nav.js",
      "frontend/select.js",
      "frontend/peek.js",
      "frontend/canvas.js",
      "frontend/model.js",
      "frontend/menu.js"
    ],
    "frontend-features": [
      "frontend/workflow.js",
      "frontend/session.js",
      "frontend/ask.js",
      "frontend/agents.js",
      "frontend/focus.js",
      "frontend/pwa.js",
      "frontend/fixes.js",
      "frontend/audit.js",
      "frontend/notify.js"
    ],
    "product": ["backend/**", "frontend/**"],
    "tests": ["test/**"],
    "backend-root": ["backend/main.rs"],
    "backend-services": [
      "backend/ask.rs",
      "backend/audit.rs",
      "backend/fix_proposals.rs",
      "backend/pull_requests.rs",
      "backend/sessions.rs"
    ],
    "backend-agents": [
      "backend/workflow.rs",
      "backend/runner.rs",
      "backend/agents.rs",
      "backend/agent_session.rs",
      "backend/task_agent.rs",
      "backend/merge.rs",
      "backend/agent_call.rs",
      "backend/run_store.rs",
      "backend/run_store_impl.rs"
    ],
    "backend-map-tools": ["backend/lookup.rs", "backend/graph_brief.rs"],
    "backend-platform": [
      "backend/process.rs",
      "backend/hash.rs",
      "backend/push.rs",
      "backend/worktree.rs",
      "backend/worker.rs"
    ],
    "adapter-contract": ["backend/adapters/mod.rs"],
    "frontend-root": ["frontend/app.js"],
    "shipped-scripts": [
      "scripts/manage.mjs",
      "scripts/package.mjs",
      "scripts/start.mjs",
      "scripts/cargo.mjs",
      "scripts/release.mjs",
      "scripts/release-notes.mjs",
      "scripts/lint-docs.mjs",
      "scripts/tunnel/**"
    ],
    "graph-brief": ["backend/graph_brief.rs"],
    "lookup-tools": ["backend/lookup.rs"],
    "single-file-adapters": [
      "backend/adapters/python.rs",
      "backend/adapters/typescript.rs"
    ],
    "rust-adapter": [
      "backend/adapters/rust.rs",
      "backend/adapters/rust_relationships.rs"
    ],
    "reference-oracle": ["test/reference/**"],
    "test-suites": ["test/*"],
    "dev-scripts": [
      "scripts/benchmark.mjs",
      "scripts/benchmark-rust.mjs",
      "scripts/guide-screenshots.mjs"
    ],
    "scripts": ["scripts/**"],
    "agent-workflow-core": [
      "backend/workflow.rs",
      "backend/agent_session.rs",
      "backend/merge.rs"
    ],
    "agent-runner": ["backend/runner.rs"],
    "agent-executor": ["backend/task_agent.rs"],
    "agent-providers": ["backend/agents.rs", "backend/run_store.rs"],
    "analysis-support": [
      "backend/relationships.rs",
      "backend/rules.rs",
      "backend/index.rs"
    ],
    "language-adapters": ["backend/adapters/**"],
    "adapter-languages": [
      "backend/adapters/python.rs",
      "backend/adapters/typescript.rs",
      "backend/adapters/rust.rs"
    ],
    "rule-checker": ["backend/rules.rs"],
    "auth-sessions": ["backend/sessions.rs"],
    "frontend-model": ["frontend/model.js"],
    "frontend-service-worker": ["frontend/sw.js"]
  },
  "rules": [
    {
      "id": "frontend-no-backend-source",
      "from": "frontend",
      "to": ["backend"],
      "kinds": ["imports", "calls", "inherits", "implements"],
      "message": "The frontend communicates through the HTTP API, not backend source imports or calls."
    },
    {
      "id": "engine-uses-adapter-contract",
      "from": "engine",
      "to": ["concrete-adapters"],
      "kinds": ["imports", "calls"],
      "message": "The repository engine must use the shared adapter registry and interface."
    },
    {
      "id": "analysis-independent-of-agents",
      "from": "analysis",
      "to": ["agent-workflow"],
      "kinds": ["imports", "calls"],
      "message": "Repository analysis must not depend on the agent workflow (dependency inversion)."
    },
    {
      "id": "product-not-test-code",
      "from": "product",
      "to": ["tests"],
      "kinds": ["imports", "calls"],
      "message": "Production code must not import test code (separation of concerns)."
    },
    {
      "id": "backend-layers",
      "layers": [
        "backend-root",
        "backend-services",
        "backend-agents",
        "backend-map-tools",
        "analysis",
        "backend-platform"
      ],
      "kinds": ["imports", "calls", "implements", "inherits"],
      "message": "Backend dependencies point down: entry point, services, agent workflow, map tools, analysis, platform (stable dependencies, no cycles)."
    },
    {
      "id": "adapters-use-the-contract",
      "from": "concrete-adapters",
      "only": ["adapter-contract", "backend-platform"],
      "kinds": ["imports", "calls"],
      "message": "A language adapter uses only the adapter contract and the platform, so a new language changes nothing else (open for extension)."
    },
    {
      "id": "frontend-layers",
      "layers": ["frontend-root", "frontend-features", "frontend-shared"],
      "kinds": ["imports", "calls", "implements", "inherits"],
      "message": "Frontend dependencies point down: app.js, then feature modules, then shared modules (stable dependencies, no cycles)."
    },
    {
      "id": "shipped-scripts-standalone",
      "from": "shipped-scripts",
      "to": ["tests", "product"],
      "kinds": ["imports", "calls"],
      "message": "Scripts that ship in the release use neither test code nor product source; they talk to the server over HTTP and the command line."
    },
    {
      "id": "frontend-features-independent",
      "from": "frontend-features",
      "to": ["frontend-features"],
      "kinds": ["imports", "calls", "implements", "inherits"],
      "message": "A frontend feature module must not use a different feature module. Connect the features in app.js or move the shared code to a shared module."
    },
    {
      "id": "graph-brief-not-lookup",
      "from": "graph-brief",
      "to": ["lookup-tools"],
      "kinds": ["imports", "calls", "implements", "inherits"],
      "message": "The map brief must not use the lookup tools. The lookup tools use the map brief."
    },
    {
      "id": "backend-services-independent",
      "from": "backend-services",
      "to": ["backend-services"],
      "kinds": ["imports", "calls", "implements", "inherits"],
      "message": "A backend service must not use a different backend service. Move the shared code to a lower layer."
    },
    {
      "id": "adapter-contract-stable",
      "from": "adapter-contract",
      "only": ["concrete-adapters", "backend-platform"],
      "kinds": ["imports", "calls"],
      "message": "The adapter contract uses only the registered adapters and the platform. Do not use the engine or other backend parts from it."
    },
    {
      "id": "single-file-adapters-independent",
      "from": "single-file-adapters",
      "to": ["concrete-adapters"],
      "kinds": ["imports", "calls", "implements", "inherits"],
      "message": "The Python and TypeScript adapters must not use a different language adapter. Put shared code in the adapter contract."
    },
    {
      "id": "rust-adapter-independent",
      "from": "rust-adapter",
      "to": ["single-file-adapters"],
      "kinds": ["imports", "calls", "implements", "inherits"],
      "message": "The Rust adapter must not use the Python or TypeScript adapter. Put shared code in the adapter contract."
    },
    {
      "id": "reference-oracle-standalone",
      "from": "reference-oracle",
      "to": ["test-suites"],
      "kinds": ["imports", "calls"],
      "message": "The reference backend must not use the test suites or their fixtures. Tests use the reference, not the opposite."
    },
    {
      "id": "shipped-scripts-not-dev-tools",
      "from": "shipped-scripts",
      "to": ["dev-scripts"],
      "kinds": ["imports", "calls"],
      "message": "A shipped script must not use a benchmark or screenshot script. These tools do not ship in the release."
    },
    {
      "id": "product-not-scripts",
      "from": "product",
      "to": ["scripts"],
      "kinds": ["imports", "calls"],
      "message": "The backend and the frontend must not use the scripts. The scripts control the product from outside."
    },
    {
      "id": "agent-workflow-layers",
      "layers": [
        "agent-workflow-core",
        "agent-runner",
        "agent-executor",
        "agent-providers"
      ],
      "kinds": ["imports", "calls", "implements", "inherits"],
      "message": "Agent dependencies point down: workflow core, runner, task agent, agent registry. Give the lower part the data it needs. Do not use the Workflow type from below."
    },
    {
      "id": "analysis-layers",
      "layers": ["engine", "analysis-support", "language-adapters"],
      "kinds": ["imports", "calls", "implements", "inherits"],
      "message": "Analysis dependencies point down: engine, then relationships, rules and index, then language adapters."
    },
    {
      "id": "rule-checker-pure",
      "from": "rule-checker",
      "only": ["backend-platform"],
      "kinds": ["imports", "calls", "implements", "inherits"],
      "message": "rules.rs uses only the platform modules. Give it the groups, rules and relationships as data."
    },
    {
      "id": "auth-sessions-isolated",
      "from": "auth-sessions",
      "only": ["backend-platform"],
      "kinds": ["imports", "calls", "implements", "inherits"],
      "message": "sessions.rs uses only the platform modules. Authentication must not depend on agents, analysis or other services."
    },
    {
      "id": "frontend-model-pure",
      "from": "frontend-model",
      "to": ["frontend"],
      "kinds": ["imports", "calls", "implements", "inherits"],
      "message": "model.js must not use other frontend modules. Keep the map model pure data logic."
    },
    {
      "id": "service-worker-standalone",
      "from": "frontend-service-worker",
      "to": ["frontend"],
      "kinds": ["imports", "calls"],
      "message": "sw.js must not use other frontend modules. The service worker runs with no DOM and no application state."
    },
    {
      "id": "language-adapters-apart",
      "from": "adapter-languages",
      "to": ["adapter-languages"],
      "kinds": ["imports", "calls", "implements", "inherits"],
      "message": "A language adapter must not use a different language adapter. Put shared code in the adapter contract."
    }
  ]
}
